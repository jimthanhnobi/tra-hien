FROM mcr.microsoft.com/dotnet/sdk:10.0.404

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY global.json ./
COPY backend/ ./backend/
COPY infra/postgres/preflight.sql ./infra/postgres/preflight.sql
RUN dotnet restore backend/TeaPremium.sln --locked-mode \
    && dotnet build backend/TeaPremium.sln --no-restore -warnaserror

ENV ASPNETCORE_ENVIRONMENT=Development \
    ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_USE_POLLING_FILE_WATCHER=1 \
    DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER=1
EXPOSE 8080

CMD ["dotnet", "watch", "--project", "backend/src/TeaPremium.Api/TeaPremium.Api.csproj", "run", "--no-launch-profile"]
