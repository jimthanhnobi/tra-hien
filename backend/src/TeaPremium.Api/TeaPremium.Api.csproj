<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <ProjectReference Include="..\TeaPremium.Application\TeaPremium.Application.csproj" />
    <ProjectReference Include="..\TeaPremium.Infrastructure\TeaPremium.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOptions>--document-name v1 --file-name openapi --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
